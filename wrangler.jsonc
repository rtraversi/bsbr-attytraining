{
  "name": "bsbr-attytraining",
  // Pinned so a wrangler logged into a different Cloudflare account (as Rob's
  // was on 2026-09-28) refuses to deploy rather than creating a stray Worker
  // there. Same account as CF_ACCOUNT_ID below.
  "account_id": "4b2a402334decc9259d7317aaf9782f0",
  "main": ".open-next/worker.js",
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-06-12",
  "preview_urls": true,
  // Workers Logs: keeps request logs and console output, searchable in the
  // dashboard (Workers > bsbr-attytraining > Logs). Without this nothing is
  // retained, so there was no record to look at after suspicious traffic.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://iurixaccreditation.com",
    // The account the Worker lives in. Not a secret — /ops/metrics needs it to
    // address the Analytics Engine SQL API, alongside the CF_ANALYTICS_TOKEN
    // secret (Account Analytics: Read).
    "CF_ACCOUNT_ID": "4b2a402334decc9259d7317aaf9782f0"
  },
  // First-party funnel events — see lib/analytics/events.ts. The dataset is
  // created on first write; no dashboard setup needed. Preview versions share
  // this binding, so queries filter on host = iurixaccreditation.com.
  "analytics_engine_datasets": [
    { "binding": "IURIX_EVENTS", "dataset": "iurix_events" }
  ]
}
