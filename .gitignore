# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare / opennext build artifacts
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keys
# Deliberately broad: .env.prod holds the PROD service-role key and was added
# 2026-08-06 so local dev can stay pointed at staging. A named-file list would
# have missed it. Anything .env* except the committed .env.example stays out.
.env*
!.env.example
.dev.vars

# local-only directories
/memory/
/landing page design resources/

# Tool-managed, per-machine. settings.local.json is a permission allowlist full of
# one developer's absolute paths — pushing it would apply Rob's grants on Max's
# machine and vice versa. The skill packs are installed by tooling and restore
# themselves. Remove these lines if we ever want project skills shared in-repo.
.claude/settings.local.json
.claude/skills/
.agents/skills/
skills-lock.json

